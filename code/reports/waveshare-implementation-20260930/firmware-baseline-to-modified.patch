+}
+void adapter_flash_service_status(char *out,unsigned capacity){
+ snprintf(out,capacity,"{\"identified\":%s,\"jedec\":\"%06lx\",\"state\":%u,\"result\":\"%s\",\"data_bytes\":%u,\"write_enabled\":%s,\"adapter_tag\":\"%016llx\",\"generation\":%lu}",known?"true":"false",(unsigned long)jedec,(unsigned)adapter_flash_engine_state(),adapter_flash_engine_result(),data_size,approved && staged && context_valid()?"true":"false",(unsigned long long)adapter_tag,(unsigned long)generation);

anelSection, PanelSectionRow, ButtonItem, staticClasses } from \"@decky/ui\";\nimport { callable, definePlugin } from \"@decky/api\";\nimport { useState } from \"react\";\n\ntype Metric = { label: string; value: number; unit: string; source: string; valid: boolean };\ntype Status = { available: boolean; state: string; metrics: Metric[] };\nconst getStatus = callable<[], Status>(\"status\");\n\nfunction Content() {\n  const [state, setState] = useState<Status>({ available: false, state: \"не прочитано\", metrics: [] });\n  const [busy, setBusy] = useState(false);\n  const refresh = async () => {\n    if (busy) return;\n    setBusy(true);\n    try { setState(await getStatus()); }\n    catch { setState({ available: false, state: \"нет связи\", metrics: [] }); }\n    finally { setBusy(false); }\n  };\n  return <PanelSection title=\"BC-250: достоверные метрики\">\n    <PanelSectionRow><ButtonItem onClick={refresh} disabled={busy}>Прочитать состояние</ButtonItem></PanelSectionRow>\n    <PanelSectionRow><div>{state.available ? \"Свежие данные Linux\" : `Нет достоверных данных: ${state.state}`}</div></PanelSectionRow>\n    {state.metrics.map((m, i) => <PanelSectionRow key={`${m.source}:${m.label}:${i}`}>\n      <div>{m.label}: {m.value.toFixed(2)} {m.unit}<div style={{fontSize: 12, opacity: 0.7}}>Источник: {m.source}</div></div>\n    </PanelSectionRow>)}\n    <PanelSectionRow><div>Без управления питанием, прошивки и записи в SMU.</div></PanelSectionRow>\n  </PanelSection>;\n}\n\nexport default definePlugin(() => ({\n  name: \"BC250 Waveshare\",\n  titleView: <div className={staticClasses.Title}>BC-250 / Waveshare</div>,\n  content: <Content />,\n  icon: <span>BC</span>,\n  onDismount() {},\n}));\n"],"names":[],"mappings":"AAEA,MAAA,QAAA,GAAiB,CAAA,MAAA,CAAA,iBAAA,CAAS;AAC1B,MAAA,WAAA,GAAA,CAAA;AAIA,MAAA,qBAAA,GAAA,MAAA,CAAA,2EAAA;AACA,IAAA,CAAA,qBAAA,EAAA;AACA,IAAA,MAAA,IAAA,KAAA,CAAA,+HAAA,CAAA;AACA;AACA,IAAA,GAAA;AACA,IAAA;AACA,IAAA,GAAA,GAAA,qBAAA,CAAA,OAAA,CAAA,WAAA,EAA
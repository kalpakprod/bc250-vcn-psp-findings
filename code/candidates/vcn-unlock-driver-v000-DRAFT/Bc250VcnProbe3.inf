# Read-only BC-250 VCN state probe, automated: writes its report to the
# marked USB stick and reboots the board. Boots as \EFI\BOOT\BOOTX64.EFI,
# no UEFI Shell needed.

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = Bc250VcnProbe3
  FILE_GUID                      = e14a3821-2026-4c91-992a-b62507802b0d
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = UefiMain

[Sources]
  Bc250VcnProbe3.c

[Packages]
  MdePkg/MdePkg.dec
  Bc250VcnUnlockPkg/Bc250VcnUnlockPkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  UefiLib
  BaseLib
  BaseMemoryLib
  PciSegmentLib
  IoLib
  PrintLib

[Protocols]
  gEfiSimpleFileSystemProtocolGuid

[Unit]
Description=BC-250 200 ms power peak sampler
After=network-online.target bc250-netconsole.service
Wants=bc250-netconsole.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/bc250-pwrwatch.sh
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=multi-user.target
#### bc250-telemetry ####
# /etc/systemd/system/bc250-telemetry.service
[Unit]
Description=BC-250 lightweight telemetry logger (GPU/CPU temp, voltage, power, clocks)
After=bc250-gpu-fixed.service
Wants=bc250-gpu-fixed.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/bc250-telemetry.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
#### bc250-gpu-fixed ####
# /etc/systemd/system/bc250-gpu-fixed.service
[Unit]
Description=BC-250 fixed GPU frequency and voltage
Wants=bc250-fan.service
After=bc250-smu-oc.service systemd-modules-load.service
Conflicts=cyan-skillfish-governor-smu.service
Before=graphical.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/bc250-gpu-fixed.sh apply
ExecStop=/usr/local/libexec/bc250-gpu-fixed.sh fallback
RemainAfterExit=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
#### bc250-netconsole ####

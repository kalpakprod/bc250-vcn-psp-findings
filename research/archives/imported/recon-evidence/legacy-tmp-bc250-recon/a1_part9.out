[Unit]
Description=BC-250 netconsole target (kernel log -> UDP off-box)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/bc250-netconsole.sh
Restart=no

[Install]
WantedBy=multi-user.target
#### bc250-cu-layout ####
# /etc/systemd/system/bc250-cu-layout.service
[Unit]
Description=BC-250 stable 38-CU dispatch layout
After=systemd-modules-load.service
Before=bc250-gpu-fixed.service display-manager.service graphical.target

[Service]

--- pwrwatch.sh ---
#!/usr/bin/env bash
set -u
H=/sys/class/drm/card1/device/hwmon/hwmon1
DP=/sys/class/drm/card1-DP-1/status
max=0; n=0; sum=0
while true; do
  p=$(cat "$H/power1_input" 2>/dev/null || echo 0)
  [ "$p" -gt "$max" ] 2>/dev/null && max=$p
  sum=$((sum+p)); n=$((n+1))
  if [ $((n % 25)) -eq 0 ]; then
    echo "<4>BC250-PWRMAX win_max_W=$((max/1000000)) win_avg_W=$((sum/n/1000000)) dp=$(cat $DP 2>/dev/null)" > /dev/kmsg 2>/dev/null
    max=0; sum=0; n=0
  fi
  sleep 0.2
done
--- telemetry.sh ---
#!/usr/bin/env bash
set -u
LOG=/var/log/bc250-telemetry.log
GPU_HWMON=""
CPU_HWMON=""
NCT_HWMON=""
for h in /sys/class/hwmon/hwmon*; do
  case "$(cat "$h/name" 2>/dev/null)" in
    amdgpu) GPU_HWMON="$h" ;;
    k10temp) CPU_HWMON="$h" ;;
    nct6686) NCT_HWMON="$h" ;;
  esac
done
DP_STATUS=/sys/class/drm/card1-DP-1/status
FAN_NODE="$NCT_HWMON/fan2_input"
i=0
while true; do
  ts=$(date -Is)
  gtemp=$(cat "$GPU_HWMON/temp1_input" 2>/dev/null || echo NA)
  gpow=$(cat "$GPU_HWMON/power1_average" 2>/dev/null || echo NA)
  gpow_input=$(cat "$GPU_HWMON/power1_input" 2>/dev/null || echo NA)
  gvolt=$(cat "$GPU_HWMON/in0_input" 2>/dev/null || echo NA)
  vddcr_vdd=$(cat "$GPU_HWMON/in1_input" 2>/dev/null || echo NA)
  gfreq=$(cat "$GPU_HWMON/freq1_input" 2>/dev/null || echo NA)
  ctemp=NA
  if [[ -n "$CPU_HWMON" ]]; then
    ctemp=$(cat "$CPU_HWMON/temp1_input" 2>/dev/null || echo NA)
  fi
  dp=NA
  [[ -r "$DP_STATUS" ]] && dp=$(cat "$DP_STATUS" 2>/dev/null || echo NA)
  fan=$(cat "$FAN_NODE" 2>/dev/null || echo NA)
  psi=$(awk -F"[= ]" "/^some/{print \$3; exit}" /proc/pressure/cpu 2>/dev/null)
  psi_io=$(awk -F"[= ]" "/^some/{print \$3; exit}" /proc/pressure/io 2>/dev/null)
  psi_mem=$(awk -F"[= ]" "/^some/{print \$3; exit}" /proc/pressure/memory 2>/dev/null)
  load=$(cut -d' ' -f1-3 /proc/loadavg)
  vram=$(cat /sys/class/drm/card1/device/mem_info_vram_used 2>/dev/null || echo NA)
  gtt=$(cat /sys/class/drm/card1/device/mem_info_gtt_used 2>/dev/null || echo NA)
  memav=$(grep MemAvailable /proc/meminfo | tr -dc '0-9')
  swpf=$(grep SwapFree /proc/meminfo | tr -dc '0-9')
  echo "$ts,gtemp_mC=$gtemp,gpow_uW=$gpow,gpow_input_uW=$gpow_input,gvolt_mV=$gvolt,vddcr_vdd_mV=$vddcr_vdd,gfreq_Hz=$gfreq,ctemp_mC=$ctemp,dp=$dp,vram_B=$vram,gtt_B=$gtt,memav_kB=$memav,swapfree_kB=$swpf,fan_rpm=$fan,psi_cpu=$psi,psi_io=$psi_io,psi_mem=$psi_mem,load=$load" >> "$LOG"
  echo "<5>BC250-TELEMETRY gtemp_mC=$gtemp gpow_uW=$gpow gpow_input_uW=$gpow_input gvolt_mV=$gvolt vddcr_vdd_mV=$vddcr_vdd gfreq_Hz=$gfreq ctemp_mC=$ctemp dp=$dp vram_B=$vram gtt_B=$gtt memav_kB=$memav swapfree_kB=$swpf fan_rpm=$fan psi_cpu=$psi psi_io=$psi_io psi_mem=$psi_mem load=$load" > /dev/kmsg 2>/dev/null
  i=$((i+1))
  sync
  if [[ -f "$LOG" ]]; then
    sz=$(stat -c%s "$LOG" 2>/dev/null || echo 0)
    if (( sz > 20000000 )); then
      mv "$LOG" "$LOG.1"
    fi
  fi
  sleep 2
done
9:    amdgpu) GPU_HWMON="$h" ;;
--- gpu-watchdog.sh head ---
#!/usr/bin/env bash
set -Eeuo pipefail
source /etc/bc250-gpu-fixed.conf
hwmon=
for path in /sys/class/drm/card[0-9]*/device/hwmon/hwmon*; do
  [[ -r "$path/name" ]] || continue
  [[ $(<"$path/name") == amdgpu ]] && hwmon=$path && break
done
[[ -n "$hwmon" ]]
tripped=0
while true; do
  temp_mC=$(<"$hwmon/temp1_input")
  temp_C=$((temp_mC / 1000))
  if (( temp_C >= THERMAL_LIMIT_C && tripped == 0 )); then
    logger -p daemon.crit -t bc250-gpu-watchdog "thermal rollback at ${temp_C}C: ${FREQUENCY_MHZ} MHz -> ${FALLBACK_FREQUENCY_MHZ} MHz"
    /usr/local/libexec/bc250-gpu-fixed.sh fallback
    touch /run/bc250-gpu-thermal-rollback
    tripped=1
  fi
  if (( temp_C <= THERMAL_RECOVERY_C && tripped == 1 )); then
    logger -p daemon.warning -t bc250-gpu-watchdog "temperature recovered to ${temp_C}C; fallback remains until reboot or manual apply"
    tripped=2
  fi
  sleep 2
done

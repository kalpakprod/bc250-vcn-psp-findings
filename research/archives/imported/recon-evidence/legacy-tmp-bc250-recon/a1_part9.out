--- metrics.py (full, read-only) ---
#!/usr/bin/env python3
"""Sample amdgpu gpu_metrics_v2_2 and ship it to /dev/kmsg (and thus netconsole)."""
import struct, time, sys

SRC = "/sys/class/drm/card1/device/gpu_metrics"
KMSG = "/dev/kmsg"
LAYOUT = "<HBB" + "HH" + "8H" + "2H" + "HH" + "Q" + "HHHH" + "8H" + "6H" + "6H" + "8H" + "2H" + "I" + "H" + "3H" + "Q"

FIELDS = [
    "size", "fmt", "cont",
    "t_gfx", "t_soc",
    *[f"t_core{i}" for i in range(8)],
    "t_l3_0", "t_l3_1",
    "act_gfx", "act_mm",
    "clock_counter",
    "p_socket", "p_cpu", "p_soc", "p_gfx",
    *[f"p_core{i}" for i in range(8)],
    "avg_gfxclk", "avg_socclk", "avg_uclk", "avg_fclk", "avg_vclk", "avg_dclk",
    "cur_gfxclk", "cur_socclk", "cur_uclk", "cur_fclk", "cur_vclk", "cur_dclk",
    *[f"coreclk{i}" for i in range(8)],
    "l3clk_0", "l3clk_1",
    "throttle", "fan_pwm",
    "pad0", "pad1", "pad2",
    "indep_throttle",
]

def valid(v, bad=0xFFFF):
    return None if v is None or v >= bad else v

def kmsg(line):
    try:
        with open(KMSG, "w") as f:
            f.write(line + "\n")
    except Exception:
        pass

def read():
    with open(SRC, "rb") as f:
        raw = f.read()
    if len(raw) < struct.calcsize(LAYOUT):
        return None
    vals = struct.unpack_from(LAYOUT, raw, 0)
    return dict(zip(FIELDS, vals))

def main():
    period = float(sys.argv[1]) if len(sys.argv) > 1 else 1.0
    last_throttle = None
    first = read()
    if not first:
        kmsg("<3>BC250-METRICS unusable gpu_metrics table")
        return 1
    kmsg("<3>BC250-METRICS start size=%d fmt=%d.%d period=%.2fs" %
         (first["size"], first["fmt"], first["cont"], period))
    while True:
        m = read()
        if m:
            cores = [valid(m[f"coreclk{i}"]) for i in range(8)]
            cores = [c for c in cores if c]
            ctemps = [valid(m[f"t_core{i}"]) for i in range(8)]
            ctemps = [c for c in ctemps if c]
            pcores = [valid(m[f"p_core{i}"]) for i in range(8)]
            pcores = [p for p in pcores if p]
            thr = m["throttle"]
            ind = m["indep_throttle"]
            fields = [
                "p_socket_mW=%s" % (valid(m["p_socket"], 0xFFFE) or "NA"),
                "p_cpu_mW=%s" % (valid(m["p_cpu"], 0xFFFE) or "NA"),
                "p_soc_mW=%s" % (valid(m["p_soc"], 0xFFFE) or "NA"),
                "p_gfx_mW=%s" % (valid(m["p_gfx"], 0xFFFE) or "NA"),
                "p_cores_mW=%d" % sum(pcores) if pcores else "p_cores_mW=NA",
                "t_gfx_cC=%s" % (valid(m["t_gfx"]) or "NA"),
                "t_soc_cC=%s" % (valid(m["t_soc"]) or "NA"),
                "t_core_max_cC=%s" % (max(ctemps) if ctemps else "NA"),
                "gfxclk=%s" % (valid(m["cur_gfxclk"]) or "NA"),
                "socclk=%s" % (valid(m["cur_socclk"]) or "NA"),
                "uclk=%s" % (valid(m["cur_uclk"]) or "NA"),
                "fclk=%s" % (valid(m["cur_fclk"]) or "NA"),
                "coreclk_max=%s" % (max(cores) if cores else "NA"),
                "act_gfx=%s" % (valid(m["act_gfx"]) or 0),
                "throttle=0x%x" % thr,
                "indep_throttle=0x%x" % ind,
            ]
            kmsg("<5>BC250-METRICS " + " ".join(str(x) for x in fields))
            if thr != last_throttle:
                kmsg("<3>BC250-THROTTLE-CHANGE from=%s to=0x%x indep=0x%x p_cpu_mW=%s p_gfx_mW=%s" %
                     ("NA" if last_throttle is None else hex(last_throttle), thr, ind,
                      valid(m["p_cpu"], 0xFFFE) or "NA", valid(m["p_gfx"], 0xFFFE) or "NA"))
                last_throttle = thr
        time.sleep(period)

if __name__ == "__main__":
    sys.exit(main())

--- package: any VCN/vclk/dclk/domain string ---

--- telemetry / metrics userspace (read configs + recent logs, no start/stop) ---
UNIT bc250-metrics path=/etc/systemd/system/bc250-metrics.service
[Unit]
Description=BC-250 SMU metrics sampler (CPU/GPU power split, throttle status)
After=bc250-netconsole.service
Wants=bc250-netconsole.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/bc250-metrics.py 1.0
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=multi-user.target
---
UNIT bc250-pwrwatch path=/etc/systemd/system/bc250-pwrwatch.service
[Unit]
Description=BC-250 200 ms power peak sampler
After=network-online.target bc250-netconsole.service
Wants=bc250-netconsole.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/bc250-pwrwatch.sh
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=multi-user.target
---
UNIT bc250-gpu-fixed path=/etc/systemd/system/bc250-gpu-fixed.service
[Unit]
Description=BC-250 fixed GPU frequency and voltage
Wants=bc250-fan.service
After=bc250-smu-oc.service systemd-modules-load.service
Conflicts=cyan-skillfish-governor-smu.service
Before=graphical.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/bc250-gpu-fixed.sh apply
ExecStop=/usr/local/libexec/bc250-gpu-fixed.sh fallback
RemainAfterExit=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
---
UNIT bc250-cu-layout path=/etc/systemd/system/bc250-cu-layout.service
[Unit]
Description=BC-250 stable 38-CU dispatch layout
After=systemd-modules-load.service
Before=bc250-gpu-fixed.service display-manager.service graphical.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/bc250-cu-layout.sh 38
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
---
UNIT bc250-netconsole path=/etc/systemd/system/bc250-netconsole.service
[Unit]
Description=BC-250 netconsole target (kernel log -> UDP off-box)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/bc250-netconsole.sh
Restart=no

[Install]
WantedBy=multi-user.target
---

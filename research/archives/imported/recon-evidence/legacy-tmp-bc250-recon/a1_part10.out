#!/usr/bin/env bash
set -u
TARGET_IP=127.0.0.1
PORT=6666
NAME=bc250

modprobe configfs 2>/dev/null
modprobe netconsole 2>/dev/null
mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config 2>/dev/null

# wait for route + ARP resolution (wifi association can lag boot)
for i in $(seq 1 60); do
  IFACE=$(ip -o route get "$TARGET_IP" 2>/dev/null | awk '{for(j=1;j<=NF;j++) if($j=="dev") print $(j+1)}')
  SRC=$(ip -o route get "$TARGET_IP" 2>/dev/null | awk '{for(j=1;j<=NF;j++) if($j=="src") print $(j+1)}')
  if [ -n "${IFACE:-}" ]; then
    ping -c 1 -W 1 "$TARGET_IP" >/dev/null 2>&1
    MAC="REDACTED"}' | head -1)
    [ -n "${MAC:"REDACTED"}" ] && break
  fi
  sleep 2
done
[ -z "${IFACE:-}" ] && { echo "bc250-netconsole: no route to $TARGET_IP" >&2; exit 1; }
[ -z "${MAC:"REDACTED"}" ] && { echo "bc250-netconsole: ARP for $TARGET_IP unresolved" >&2; exit 1; }

T=/sys/kernel/config/netconsole/$NAME
if [ -d "$T" ]; then
  echo 0 > "$T/enabled" 2>/dev/null
  rmdir "$T" 2>/dev/null
fi
mkdir -p "$T" || exit 1
echo 0 > "$T/enabled"
echo 1 > "$T/extended"
echo "$IFACE" > "$T/dev_name"
echo "$SRC"   > "$T/local_ip"
echo "$PORT"  > "$T/local_port"
echo "$TARGET_IP" > "$T/remote_ip"
echo "$PORT"  > "$T/remote_port"
echo "$MAC"   > "$T/remote_mac"
echo 1 > "$T/enabled"

dmesg -n 8 2>/dev/null
echo "<4>BC250-NETCONSOLE-ONLINE iface=$IFACE src=$SRC dst=$TARGET_IP:$PORT mac="REDACTED"
=== PART10 DONE ===

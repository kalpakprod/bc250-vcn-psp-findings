# /etc/systemd/system/bc250-netconsole.service
[Unit]
Description=BC-250 netconsole target (kernel log -> UDP off-box)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/bc250-netconsole.sh
Restart=no

[Install]
WantedBy=multi-user.target
